{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [ "node" ],
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationDir": "lib/types"
  },
  "include": [ "src/**/*" ],
  "exclude": [ "node_modules", "lib", "tests" ]
}